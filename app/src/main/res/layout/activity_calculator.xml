<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorOnPrimary"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:layout_marginTop="27dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Назад"
            android:textSize="15sp"
            app:cornerRadius="15dp"
            style="@style/GreenButton"/>

        <Spinner
            android:id="@+id/spinnerBase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:layout_weight="1"
            android:layout_marginStart="10dp" />

        <Spinner
            android:id="@+id/spinnerBits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp" />

        <CheckBox
            android:id="@+id/cbSigned"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="5dp"
            android:text="UNSIGN"
            android:textSize="12sp"
            android:layout_marginStart="5dp"
            android:textColor="@color/accent_green" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_display"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvExpression"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="end"
            android:minHeight="20dp"
            android:ellipsize="start"
            android:singleLine="true"/>

        <TextView
            android:id="@+id/tvDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/accent_green"
            android:textSize="38sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:gravity="end"
            android:layout_marginTop="4dp"
            android:ellipsize="start"
            android:singleLine="true"/>
    </LinearLayout>

    <!-- Bit operations row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="AND"
            android:fontFamily="@font/pixel"
            android:layout_marginEnd="4dp"
            style="@style/BitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/pixel"
            android:text="OR"
            android:layout_marginEnd="4dp"
            style="@style/BitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNot"
            android:layout_width="0dp"
            android:fontFamily="@font/pixel"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="NOT"
            android:layout_marginEnd="4dp"
            style="@style/BitButton"/>
    </LinearLayout>

    <!-- Digit grid + operations -->
    <!-- Row: C / DEL / % / / -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="C"
            android:textSize="25sp"
            android:layout_marginEnd="6dp"
            style="@style/ClearButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Del"
            android:textSize="25sp"
            android:layout_marginEnd="6dp"
            style="@style/OpButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMod"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="%"
            android:textSize="25sp"
            android:layout_marginEnd="6dp"
            style="@style/OpButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:textSize="25sp"
            android:text="&#247;"
            style="@style/OpButton"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnD"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="D"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnE"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="E"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnF"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="F"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMul"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="&#215;"
            android:textSize="25sp"
            style="@style/OpButton"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnA"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="A"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="B"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnC_hex"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="C"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="&#8722;"
            android:textSize="25sp"
            style="@style/OpButton"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn7"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="7"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn8"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="8"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn9"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="9"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="+"
            android:textSize="25sp"
            style="@style/OpButton"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="4"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="5"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn6"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="6"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNeg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="+/-"
            android:textSize="25sp"
            style="@style/OpButton"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="1"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="2"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="3"
            android:layout_marginEnd="6dp"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPoint"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="•"
            android:textSize="35sp"
            style="@style/OpButton"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="0"
            android:layout_gravity="center"
            style="@style/DigitButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEqual"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="="
            style="@style/EqualButton"
            android:textSize="35sp"
            android:layout_weight="3"
            android:layout_gravity="center"
            android:layout_marginStart="5dp"/>


    </LinearLayout>

</LinearLayout>

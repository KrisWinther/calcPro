<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ProgrammerCalc" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_green</item>
        <item name="colorPrimaryVariant">@color/accent_green_dark</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="colorControlActivated">@color/accent_green</item>
        <item name="colorControlHighlight">@color/accent_green_dim</item>

        <item name="spinnerStyle">@style/SpinnerStyle</item>
    </style>

    <style name="SpinnerStyle" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@drawable/bg_spinner</item>
        <item name="android:popupBackground">@color/bg_card</item>
        <item name="android:padding">4dp</item>
    </style>

    <style name="GreenButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_op_bg</item>
        <item name="android:textColor">@color/accent_green</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="AccentButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_green</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="DigitButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/btn_digit_bg</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="OpButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_op_bg</item>
        <item name="android:textColor">@color/accent_green</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="BitButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_bit_bg</item>
        <item name="android:textColor">#7BA7FF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="EqualButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/btn_eq_bg</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="ClearButton" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#3D1A1A</item>
        <item name="android:textColor">@color/error_red</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
